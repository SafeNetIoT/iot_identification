FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the repo
COPY . .

# Install in editable mode for development
RUN pip install -e .

# Set environment variable for project root
ENV PROJECT_ROOT=/app

# Make shell scripts executable
RUN chmod +x ./scripts/setup.sh ./scripts/train_model.sh ./scripts/setup_hooks.sh ./scripts/raw_data.sh

# Run setup script to prepare data and directories
RUN ./scripts/setup.sh

# Default command (training script)
CMD ["bash", "./scripts/train_model.sh"]
